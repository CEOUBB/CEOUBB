rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isOwner() {
      return email() == 'elpapijuaco325@gmail.com' || email() == 'felipearce.2004@gmail.com';
    }

    function isStudent() {
      return email().matches('^[^@]+@alumnos\\.ubiobio\\.cl$');
    }

    function isTeacherEmail() {
      return email().matches('^[^@]+@ubiobio\\.cl$');
    }

    function isTeacher() {
      return isOwner() || isTeacherEmail();
    }

    function isMember() {
      return isOwner() || isStudent() || isTeacherEmail();
    }

    function validCourse(courseId) {
      return courseId.matches('^[a-z][a-z0-9-]{1,30}$');
    }

    match /courses/{courseId}/{userId}/{fileName} {
      allow read: if isMember();
      allow create, update: if isTeacher() && validCourse(courseId) && request.auth.uid == userId && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isOwner() || isTeacher() && request.auth.uid == userId;
    }
  }
}
