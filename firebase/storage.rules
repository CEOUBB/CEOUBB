rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isStudent() {
      return email().matches('^[^@]+@alumnos\\.ubiobio\\.cl$');
    }

    function isTeacherEmail() {
      return email().matches('^[^@]+@ubiobio\\.cl$');
    }

    // Implements: REQ-SEC-01 — mismo criterio que Firestore: el rango sale del
    // documento del usuario, nunca de correos personales escritos en la regla.
    function role() {
      return signedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isTeacher() {
      return isOwner() || isTeacherEmail() && role() == 'teacher';
    }

    function isMember() {
      return isOwner() || isStudent() && role() == 'student' || isTeacherEmail() && role() == 'teacher';
    }

    function validCourse(courseId) {
      return courseId.matches('^[a-z0-9][a-z0-9-]{1,60}$');
    }

    function sectionPeriodId(seccionId) {
      return firestore.get(/databases/(default)/documents/academicSections/$(seccionId)).data.periodoId;
    }

    function sectionIsWritable(seccionId) {
      return signedIn()
        && validCourse(seccionId)
        && firestore.exists(/databases/(default)/documents/academicSections/$(seccionId))
        && firestore.exists(/databases/(default)/documents/academicPeriods/$(sectionPeriodId(seccionId)))
        && firestore.get(/databases/(default)/documents/academicPeriods/$(sectionPeriodId(seccionId))).data.status == 'abierto';
    }

    // Implements: REQ-SEC-02
    function isEnrolled(seccionId) {
      return signedIn() && firestore.exists(/databases/(default)/documents/enrollments/$(request.auth.uid)/sections/$(seccionId));
    }

    // Implements: REQ-ASST-01, REQ-ASST-02
    function sectionRole(seccionId) {
      return isEnrolled(seccionId)
        ? firestore.get(/databases/(default)/documents/enrollments/$(request.auth.uid)/sections/$(seccionId)).data.role
        : '';
    }

    function teachesSection(seccionId) {
      return isOwner() || isTeacher() && isEnrolled(seccionId);
    }

    // Implements: REQ-ASST-03, REQ-ASST-04, REQ-ASST-05
    function assistsSection(seccionId) {
      return isMember() && isEnrolled(seccionId) && sectionRole(seccionId) == 'assistant';
    }

    function managesSectionContent(seccionId) {
      return teachesSection(seccionId) || assistsSection(seccionId);
    }

    // Whitelist segura para archivos académicos: prohíbe explícitamente HTML, SVG, scripts y ejecutables
    function isAllowedAcademicMimeType() {
      return request.resource.contentType.matches('^(application/pdf|application/zip|application/x-zip-compressed|application/vnd\\.openxmlformats-officedocument\\.[a-z0-9.-]+|application/msword|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint|image/(png|jpeg|webp)|text/plain|text/csv)$');
    }

    /*
      Foto de perfil. Cada cuenta escribe únicamente bajo su propio prefijo, con
      tipo de imagen admitido y 2 MB de techo: es un avatar, no un adjunto. La
      lectura queda abierta a cualquier sesión institucional porque el avatar se
      muestra en listas de participantes y en el hilo de mensajes.
    */
    // Implements: REQ-CFG-02, REQ-CFG-03
    match /avatars/{userId}/{fileName} {
      allow read: if isMember();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('^image/(png|jpeg|webp)$');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Material del curso publicado por el equipo docente.
    match /courses/{courseId}/{userId}/{fileName} {
      allow read: if isOwner() || isMember() && isEnrolled(courseId);
      allow create, update: if managesSectionContent(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && request.auth.uid == userId && request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024 && isAllowedAcademicMimeType();
      allow delete: if (isOwner() || managesSectionContent(courseId) && request.auth.uid == userId) && sectionIsWritable(courseId);
    }

    /*
      Buzón de entregas. Cada estudiante matriculado escribe únicamente bajo su
      propio UID y el docente de la sección puede leer para corregir. 25 MB es
      el techo por archivo: un informe con imágenes cabe, un video no.
    */
    // Implements: REQ-EVAL-01
    match /courses/{courseId}/submissions/{evalId}/{userId}/{fileName} {
      allow read: if isOwner() || teachesSection(courseId) || signedIn() && request.auth.uid == userId;
      allow create, update: if isMember() && isEnrolled(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && request.auth.uid == userId && request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024 && isAllowedAcademicMimeType();
      allow delete: if (isOwner() || signedIn() && request.auth.uid == userId) && sectionIsWritable(courseId);
    }
  }
}
