rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isOwner() {
      return email() == 'elpapijuaco325@gmail.com' || email() == 'felipearce.2004@gmail.com';
    }

    function isStudent() {
      return email().matches('^[^@]+@alumnos\\.ubiobio\\.cl$');
    }

    function isTeacherEmail() {
      return email().matches('^[^@]+@ubiobio\\.cl$');
    }

    function role() {
      return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }

    function isTeacher() {
      return isOwner() || isTeacherEmail() && role() == 'teacher';
    }

    function isMember() {
      return isOwner() || isStudent() && role() == 'student' || isTeacherEmail() && role() == 'teacher';
    }

    function expectedRole() {
      return isOwner() ? 'owner' : isTeacherEmail() ? 'teacher' : 'student';
    }

    function validCourse(courseId) {
      return courseId.matches('^[a-z][a-z0-9-]{1,30}$');
    }

    match /users/{userId} {
      allow read: if isOwner() || signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && (isOwner() || isStudent() || isTeacherEmail()) && request.resource.data.role == expectedRole();
      allow update: if isOwner() || signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'domain', 'lastSeen', 'teacherRequested', 'requestedAt']);
      allow delete: if isOwner();

      // Bloques del calendario semanal. Estrictamente privados: ni el owner
      // ni un docente pueden leer la agenda personal de otra cuenta.
      match /calendar_events/{eventId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /courses/{courseId}/posts/{postId} {
      allow read: if isMember();
      allow create: if isTeacher() && validCourse(courseId) && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner() || isTeacher() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isOwner() || isTeacher() && resource.data.authorId == request.auth.uid;
    }

    match /courses/{courseId}/progress/{userId} {
      allow read: if isOwner() || isTeacher() || signedIn() && request.auth.uid == userId;
      allow create, update: if isMember() && validCourse(courseId) && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if isOwner() || signedIn() && request.auth.uid == userId;
    }

    match /courses/{courseId}/meta/{documentId} {
      allow read: if isMember();
      allow write: if isTeacher() && validCourse(courseId);
    }

    match /courses/{courseId}/grades/{userId} {
      allow read: if isOwner() || isTeacher() || signedIn() && request.auth.uid == userId;
      allow write: if isTeacher() && validCourse(courseId);
    }

    match /{path=**}/posts/{postId} {
      allow read: if isMember();
    }

    match /{path=**}/meta/{documentId} {
      allow read: if isMember();
    }
  }
}
