rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function isStudent() {
      return email().matches('^[^@]+@alumnos\\.ubiobio\\.cl$');
    }

    function isTeacherEmail() {
      return email().matches('^[^@]+@ubiobio\\.cl$');
    }

    // Implements: REQ-SEC-01 — el rango administrativo vive en el documento del
    // usuario, no en una lista de correos personales incrustada en las reglas.
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isOwner() {
      return role() == 'owner';
    }

    function isTeacher() {
      return isOwner() || isTeacherEmail() && role() == 'teacher';
    }

    function isMember() {
      return isOwner() || isStudent() && role() == 'student' || isTeacherEmail() && role() == 'teacher';
    }

    function expectedRole() {
      return isTeacherEmail() ? 'teacher' : 'student';
    }

    function validCourse(courseId) {
      return courseId.matches('^[a-z0-9][a-z0-9-]{1,60}$');
    }

    function sectionPeriodId(seccionId) {
      return get(/databases/$(database)/documents/academicSections/$(seccionId)).data.periodoId;
    }

    function sectionIsWritable(seccionId) {
      return signedIn()
        && validCourse(seccionId)
        && exists(/databases/$(database)/documents/academicSections/$(seccionId))
        && exists(/databases/$(database)/documents/academicPeriods/$(sectionPeriodId(seccionId)))
        && get(/databases/$(database)/documents/academicPeriods/$(sectionPeriodId(seccionId))).data.status == 'abierto';
    }

    function validCommunicationBody(value) {
      return value is string && value.size() > 0 && value.size() <= 2000;
    }

    function validParticipantName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function threadParticipant(courseId, threadId) {
      return teachesCommunicationSection(courseId) || signedIn() && request.auth.uid == threadId && isEnrolled(courseId);
    }

    function validThreadShape(courseId, threadId) {
      return request.resource.data.keys().hasOnly(['courseId', 'studentId', 'studentName', 'studentEmail', 'latestBody', 'latestAuthorId', 'latestAuthorName', 'createdAt', 'updatedAt'])
        && request.resource.data.courseId == courseId
        && request.resource.data.studentId == threadId
        && validParticipantName(request.resource.data.studentName)
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.size() <= 254
        && validCommunicationBody(request.resource.data.latestBody)
        && request.resource.data.latestAuthorId == request.auth.uid
        && validParticipantName(request.resource.data.latestAuthorName)
        && request.resource.data.updatedAt == request.time;
    }

    function validThreadCreate(courseId, threadId) {
      return signedIn() && request.auth.uid == threadId && isEnrolled(courseId)
        && validCourse(courseId)
        && validThreadShape(courseId, threadId)
        && request.resource.data.studentEmail == email()
        && request.resource.data.createdAt == request.time;
    }

    function validThreadUpdate(courseId, threadId) {
      return validThreadShape(courseId, threadId)
        && request.resource.data.studentName == resource.data.studentName
        && request.resource.data.studentEmail == resource.data.studentEmail
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validDirectMessage(courseId, threadId) {
      return request.resource.data.keys().hasOnly(['courseId', 'threadId', 'authorId', 'authorName', 'body', 'createdAt'])
        && request.resource.data.courseId == courseId
        && request.resource.data.threadId == threadId
        && request.resource.data.authorId == request.auth.uid
        && validParticipantName(request.resource.data.authorName)
        && validCommunicationBody(request.resource.data.body)
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/courses/$(courseId)/messageThreads/$(threadId))
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/messageThreads/$(threadId)).data.latestBody == request.resource.data.body
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/messageThreads/$(threadId)).data.latestAuthorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/courses/$(courseId)/messageThreads/$(threadId)).data.updatedAt == request.time;
    }

    function validReadCursor(cursorId) {
      return request.resource.data.keys().hasOnly(['key', 'readAt'])
        && request.resource.data.key == cursorId
        && cursorId.size() <= 180
        && request.resource.data.readAt == request.time;
    }

    // Implements: REQ-LIVE-02, REQ-LIVE-06
    function validLiveClass(courseId) {
      return request.resource.data.keys().hasOnly(['courseId', 'url', 'provider', 'updatedBy', 'updatedAt'])
        && request.resource.data.courseId == courseId
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 2048
        && (request.resource.data.provider == 'zoom'
          && request.resource.data.url.matches('^https://([A-Za-z0-9-]+\\.)*zoom\\.us(:[0-9]+)?([/?#].*)?$')
          || request.resource.data.provider == 'teams'
          && request.resource.data.url.matches('^https://(teams\\.microsoft\\.com|teams\\.cloud\\.microsoft)(:[0-9]+)?([/?#].*)?$'));
    }

    // Implements: REQ-SEC-02 — la proyección de matrícula es la única llave de
    // una sección: sin marcador activo no hay lectura ni escritura posible.
    function isEnrolled(seccionId) {
      return signedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid)/sections/$(seccionId));
    }

    // Implements: REQ-ASST-01, REQ-ASST-02
    function sectionRole(seccionId) {
      return isEnrolled(seccionId)
        ? get(/databases/$(database)/documents/enrollments/$(request.auth.uid)/sections/$(seccionId)).data.role
        : '';
    }

    function teachesSection(seccionId) {
      return isOwner() || isTeacher() && isEnrolled(seccionId);
    }

    function teachesCommunicationSection(seccionId) {
      return isOwner() || teachesSection(seccionId) && (sectionRole(seccionId) == 'teacher' || sectionRole(seccionId) == 'coordinator');
    }

    // Implements: REQ-ASST-03, REQ-ASST-04, REQ-ASST-05
    function assistsSection(seccionId) {
      return isMember() && isEnrolled(seccionId) && sectionRole(seccionId) == 'assistant';
    }

    function managesSectionContent(seccionId) {
      return teachesSection(seccionId) || assistsSection(seccionId);
    }

    match /users/{userId} {
      allow read: if isOwner() || signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && (isStudent() || isTeacherEmail()) && request.resource.data.role == expectedRole();
      // Implements: REQ-CAP-18 — 'fcmToken' es la única ampliación de la app
      // nativa: el propio dueño escribe su token FCM y nada más. El rol sigue
      // congelado y `hasOnly` mantiene el resto del documento fuera de alcance.
      allow update: if isOwner() || signedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'domain', 'lastSeen', 'teacherRequested', 'requestedAt', 'fcmToken']);
      allow delete: if isOwner();

      // Bloques del calendario semanal. Estrictamente privados: ni el owner
      // ni un docente pueden leer la agenda personal de otra cuenta.
      match /calendar_events/{eventId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /notificationReads/{cursorId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId && validReadCursor(cursorId);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      /*
        Preferencias de notificación y accesibilidad. Sólo su dueño las lee, y
        la escritura llega desde la ruta API con cuenta de servicio: para el
        cliente el documento es de sólo lectura, de modo que la validación Zod
        del servidor no se pueda esquivar escribiendo directo a Firestore.
      */
      // Implements: REQ-CFG-04, REQ-CFG-05
      match /settings/{documentId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    /*
      Proyección de matrículas escrita sólo por el servidor con credenciales de
      cuenta de servicio (que ignoran estas reglas). Para el cliente es de sólo
      lectura y sólo sobre su propio expediente.
    */
    // Implements: REQ-ACAD-02
    match /enrollments/{userId}/sections/{seccionId} {
      allow read: if isOwner() || signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Implements: REQ-SEC-02
    match /courses/{courseId}/posts/{postId} {
      allow read: if isOwner() || isMember() && isEnrolled(courseId);
      allow create: if managesSectionContent(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && request.resource.data.authorId == request.auth.uid;
      allow update: if (isOwner() || managesSectionContent(courseId) && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId) && sectionIsWritable(courseId);
      allow delete: if (isOwner() || managesSectionContent(courseId) && resource.data.authorId == request.auth.uid) && sectionIsWritable(courseId);
    }

    match /courses/{courseId}/messageThreads/{threadId} {
      allow read: if threadParticipant(courseId, threadId);
      allow create: if validThreadCreate(courseId, threadId);
      allow update: if threadParticipant(courseId, threadId) && validThreadUpdate(courseId, threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if threadParticipant(courseId, threadId);
        allow create: if threadParticipant(courseId, threadId) && validDirectMessage(courseId, threadId);
        allow update, delete: if false;
      }
    }

    // Implements: REQ-SEC-02
    match /courses/{courseId}/progress/{userId} {
      allow read: if isOwner() || teachesSection(courseId) || signedIn() && request.auth.uid == userId;
      allow create, update: if isMember() && isEnrolled(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if (isOwner() || signedIn() && request.auth.uid == userId) && sectionIsWritable(courseId);
    }

    // Implements: REQ-SEC-02, REQ-LIVE-02, REQ-LIVE-06
    match /courses/{courseId}/meta/{documentId} {
      allow read: if isOwner() || isMember() && isEnrolled(courseId);
      allow write: if teachesSection(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && documentId != 'gradebook'
        && (documentId != 'live-class' || request.method == 'delete' || validLiveClass(courseId));
    }

    // Implements: REQ-SEC-02, REQ-AUDIT-03
    match /courses/{courseId}/grades/{userId} {
      allow read: if isOwner() || teachesSection(courseId) || signedIn() && request.auth.uid == userId && isEnrolled(courseId);
      allow write: if false;
    }

    // Implements: REQ-AUDIT-03, REQ-AUDIT-05
    match /courses/{courseId}/gradeAudit/{auditId} {
      allow read: if teachesSection(courseId) || signedIn() && isStudent() && role() == 'student' && isEnrolled(courseId) && resource.data.targetType in ['score', 'feedback'] && resource.data.studentId == request.auth.uid;
      allow write: if false;
    }

    // Implements: REQ-EVAL-01, REQ-SEC-08
    match /courses/{courseId}/submissions/{submissionId} {
      allow read: if isOwner() || teachesSection(courseId) || signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isMember() && isEnrolled(courseId) && validCourse(courseId) && sectionIsWritable(courseId) && request.resource.data.uid == request.auth.uid && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if (isOwner() || signedIn() && resource.data.uid == request.auth.uid) && sectionIsWritable(courseId);
    }
  }
}
