# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Code files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rules text eol=lf

# Scripts
*.sh text eol=lf
gradlew text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.jar binary
*.aar binary
*.jks binary
*.keystore binary
*.db binary
*.sqlite binary
*.sqlite3 binary
