{
  "name": "centro-de-estudio-ubb-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "next build && node --experimental-strip-types --test tests/access-policy.test.ts tests/grades.test.ts tests/planner.test.ts tests/linear-webhook.test.ts tests/github-webhook.test.ts tests/rendered-html.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/access-policy.test.ts tests/grades.test.ts tests/planner.test.ts tests/linear-webhook.test.ts tests/github-webhook.test.ts",
    "typecheck": "tsc --noEmit",
    "check:functions": "node --check firebase/functions/index.js",
    "lint": "eslint .",
    "doctor": "react-doctor",
    "db:generate": "drizzle-kit generate",
    "bot:bridge": "node scripts/discord-claude-bridge.js",
    "bot:codex": "node scripts/discord-codex-bridge.js",
    "bot:antigravity": "node scripts/discord-antigravity-bridge.js",
    "bot:standup": "node scripts/daily-standup-bot.js",
    "bot:autostart:claude": "powershell -ExecutionPolicy Bypass -File scripts/setup-claude-autostart.ps1",
    "bot:autostart:codex": "powershell -ExecutionPolicy Bypass -File scripts/setup-codex-autostart.ps1",
    "bot:autostart:antigravity": "powershell -ExecutionPolicy Bypass -File scripts/setup-antigravity-autostart.ps1"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@libsql/client": "^0.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/functions": "^3.9.3",
    "discord.js": "^14.27.0",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.1",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "react-doctor": "^0.9.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vercel": "^58.9.1"
  },
  "type": "module"
}
